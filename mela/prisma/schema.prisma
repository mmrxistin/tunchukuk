generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id                    String         @id
  username              String         @unique
  displayName           String
  email                 String?        @unique
  passwordHash          String?
  googleId              String?        @unique
  avatarUrl             String?
  bio                   String?
  sessions              Session[]
  duyem                 Duyem[]
  du                 du[]
  Yek                 Yek[]        // <-- add this line
  Penc                   Penc[]
  createdAt   DateTime      @default(now())
  yekine       yekine[]        // renamed relation (was Mmhewcedari)
  Dirok       Dirok[]
  Mmmpeyam    Mmmpeyam[]
  Tefsir      Tefsir[]
  yekine        yekine[]
  Car       Car[]
  se       se[]
  xane        Xane[]
  rojname     Rojname[]
  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}


model Yek {
  id          String  @id @default(cuid())
  content     String[]
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Media[]


  createdAt           DateTime       @default(now())

  @@map("Yek")
}

model Duyem {
  id                  String         @id @default(cuid())
  content             String[]
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments         Media[]

  createdAt DateTime @default(now())

  @@map("duyem")
}
model Mmmpeyam {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  // optional relation to User (keeps existing User.Mmmpeyam[] valid)
  userId String? 
  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("mmmpeyam")
}

model Xane {
  id                  String         @id @default(cuid())
  content             String[]
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments         Media[]

  createdAt DateTime @default(now())

  @@map("xane")
}


// ---------------------------
// MEDIA
// ---------------------------
model Media {
  id         String    @id @default(cuid())
  type       MediaType
  url        String
  createdAt  DateTime  @default(now())

  // relations to content tables
  YekId    String?
  Yek      Yek?    @relation(fields: [YekId], references: [id])

  duyemId    String?
  Duyem      Duyem?    @relation(fields: [duyemId], references: [id], onDelete: SetNull)

  xaneId     String?
  Xane       Xane?     @relation(fields: [xaneId], references: [id], onDelete: SetNull)

  PencId      String?
  Penc        Penc?      @relation(fields: [PencId], references: [id], onDelete: SetNull)

  yekineId     String?
  yekine       yekine?     @relation(fields: [yekineId], references: [id])

  tefsirId   String?
  Tefsir     Tefsir?   @relation(fields: [tefsirId], references: [id])

  duId    String?
  du      du?    @relation(fields: [duId], references: [id])

  seId    String?
  se      se?    @relation(fields: [seId], references: [id])

  CarId    String?
  Car      Car?    @relation(fields: [CarId], references: [id])

  dirokId    String?
  Dirok      Dirok?    @relation(fields: [dirokId], references: [id])

  yekineId    String?
  yekine      yekine?    @relation(fields: [yekineId], references: [id])

  rojnameId  String?
  Rojname    Rojname?  @relation(fields: [rojnameId], references: [id], onDelete: SetNull)

  @@map("post_media")
}

enum MediaType {
  IMAGE
  VIDEO
}


































model Rojname {
  id                  String         @id @default(cuid())
  content             String[]
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments         Media[]

  createdAt DateTime @default(now())

  @@map("rojname")
}
model Penc {
  id                  String         @id @default(cuid())
  content             String[]
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments         Media[]

  createdAt DateTime @default(now())

  @@map("Penc")
}

